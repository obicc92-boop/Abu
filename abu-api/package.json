{
  "name": "abu-api",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply abu --remote",
    "deploy": "npm --prefix ../abu-app run build:web && wrangler d1 migrations apply abu --remote && wrangler deploy"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  }
}
