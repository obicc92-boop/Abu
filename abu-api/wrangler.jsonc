// The "abu" Worker: serves the web app (built into ../abu-app/dist) and the
// API under /api, backed by the D1 database "abu".
// Deploy with `npm run deploy` (builds the web app first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abu",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../abu-app/dist",
    "binding": "ASSETS",
    // Only the API and shared links' pages (a song's, an invite's: their link previews, src/share.ts) run Worker code;
    // other pages and files are served directly.
    "run_worker_first": ["/api/*", "/song/*", "/join"],
    // /song/old100 serves song/old100.html
    "html_handling": "auto-trailing-slash",
    // The web app is a single-page app: any other path loads it, and its router takes over.
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abu",
      "database_id": "c69131cb-a523-4959-a843-e2d4fcbc5d83",
      "migrations_dir": "migrations",
    },
  ],
  // Original sheets (PDFs and photos), keyed by song; and profile pictures (owner's request, 21 November 2026),
  // keyed by person, a new key for each picture so phones can keep them.
  "r2_buckets": [
    { "binding": "SHEETS", "bucket_name": "abu-sheets" },
    { "binding": "AVATARS", "bucket_name": "abu-avatars" },
    // Songs' cover pictures (Home's redesign, 25 November 2026), uploaded or made by AI: keyed by song, a new key for
    // each picture, like profile pictures.
    { "binding": "COVERS", "bucket_name": "abu-covers" },
  ],
  // Cloudflare's own AI (Workers AI), for scanning: corrects lines SolfaScores' own reader got wrong, and reads words in pictures.
  "ai": { "binding": "AI" },
  // Making AI covers smaller before they're kept (src/covers.ts): Cloudflare's Images binding.
  "images": { "binding": "IMAGES" },
  // Email (src/email.ts), through Cloudflare's Email Service: the link to choose a new password, from no-reply@ only.
  // Sending to any address needs the Workers Paid plan, and solfascores.com set up for sending in the dashboard.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@solfascores.com"] }],
  // The app's own address, and www, which the page sends on to it. The old address,
  // abu.adalingo.workers.dev, stays on: its pages send people to solfascores.com, and links
  // shared before the move keep working.
  "routes": [
    { "pattern": "solfascores.com", "custom_domain": true },
    { "pattern": "www.solfascores.com", "custom_domain": true },
  ],
  "workers_dev": true,
  // Where sign-in lives.
  "vars": { "BETTER_AUTH_URL": "https://solfascores.com" },
  "observability": { "enabled": true },
}
