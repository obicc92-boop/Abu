// Cloudflare Workers static assets: serves the web export in dist/.
// Build and deploy with `npm run deploy:web`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abu",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // /song/old100 serves song/old100.html
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html (a copy of Expo Router's +not-found page)
    "not_found_handling": "404-page",
  },
}
