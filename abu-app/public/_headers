# Cloudflare headers. Scripts, fonts and images have content hashes in their
# names, so phones can keep them: less data on every visit.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the manifest must always be checked, so a new version
# of SolfaScores reaches phones on their next visit.
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# Instrument sounds (Me → Settings → Sound): their addresses carry the set's version (?v=), bumped when it's
# rebuilt, so phones can keep them.
/sounds/*
  Cache-Control: public, max-age=31536000, immutable

# The link-preview picture (design/brand/share.html). Apps that show previews keep their own copy for a while anyway.
/share/*
  Cache-Control: public, max-age=86400
