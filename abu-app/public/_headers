# Cloudflare headers. Scripts, fonts and images have content hashes in their
# names, so phones can keep them: less data on every visit.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the manifest must always be checked, so a new version
# of Abụ reaches phones on their next visit.
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
